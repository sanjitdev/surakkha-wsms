# pnpm config — single-package React app, MSW + Vite
# Hoisted node_modules keeps Vite + MSW worker happy (pnpm's default
# isolated symlinks break MSW's service worker file resolution).
node-linker=hoisted

# MSW declares peer deps; without this, `pnpm install` warns and the
# service worker may not load at runtime.
auto-install-peers=true

# Suppress the build-scripts approval prompt for MSW's postinstall.
# MSW runs `msw init` and writes public/mockServiceWorker.js.
enable-pre-post-scripts=true
